rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Stocks data: Public read, no write (system generated)
    match /stocks/{symbol} {
      allow read: if true;
      allow write: if false; 
    }
    
    // User Price Alerts: Owner only
    function isValidPriceAlert(data) {
        return data.symbol is string && data.symbol.size() <= 64 &&
               data.condition is string && (data.condition == 'above' || data.condition == 'below') &&
               data.value is number &&
               data.active is bool;
    }

    match /users/{userId}/priceAlerts/{alertId} {
      allow read, delete: if isOwner(userId) && isValidId(alertId);
      allow create: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming());
      allow update: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['value', 'active', 'triggeredAt']);
    }
  }
}
