rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Stocks data: Public read, no write (for now)
    match /stocks/{symbol} {
      allow read: if true;
      allow write: if false; // System generated
    }
    
    // User Price Alerts: Owner only
    match /users/{userId}/priceAlerts/{alertId} {
      allow read, write: if isOwner(userId) && isValidId(alertId);
    }
  }
}
